#!/usr/bin/env python3
"""Generate an independent HFLedger Phase 3 installation."""

import argparse
import json
import os
import sys


ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
if ROOT not in sys.path:
    sys.path.insert(0, ROOT)

from install.generate import configure_install  # noqa: E402


def build_parser():
    parser = argparse.ArgumentParser(
        prog="ledger-install",
        description="Initialize HFLedger and generate inactive agent packs and schedules.")
    parser.add_argument("directory", help="new HFLedger data directory")
    parser.add_argument("--project", required=True, help="project label")
    parser.add_argument(
        "--repo", action="append", default=[],
        help="GitHub source as ID,OWNER/REPOSITORY,STAGE,PRODUCTION; repeat as needed")
    parser.add_argument(
        "--local-root", action="append", default=[],
        help="local metadata source as ID=PATH; repeat as needed")
    parser.add_argument(
        "--local-pattern", action="append", default=[],
        help="relative glob for every local root; defaults to **/*.md")
    parser.add_argument(
        "--runtime", action="append", choices=("codex", "generic", "claude-code"), default=[],
        help="agent pack runtime; repeat as needed; defaults to generic")
    parser.add_argument(
        "--schedule", choices=("none", "launchd", "systemd", "both"), default="none",
        help="generate inactive schedule definitions")
    parser.add_argument("--hour", type=int, default=7, help="scheduled local hour (0-23)")
    parser.add_argument("--minute", type=int, default=0, help="scheduled minute (0-59)")
    return parser


def main(argv=None):
    args = build_parser().parse_args(argv)
    try:
        result = configure_install(
            args.directory, args.project, repositories=args.repo,
            local_roots=args.local_root, patterns=args.local_pattern or None,
            runtimes=args.runtime or None, schedule=args.schedule,
            hour=args.hour, minute=args.minute)
        print(json.dumps(result, indent=2, sort_keys=True))
        return 0
    except (OSError, ValueError) as exc:
        print("ledger-install: %s" % exc, file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
