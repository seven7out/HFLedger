{
  "version": 1,
  "project": "Ovenlight Bakery Tools",
  "backupRetention": 12,
  "quarantineLimit": 40,
  "ui": {
    "title": "Ovenlight Control Room",
    "subtitle": "Fictional bakery agents, with a quieter human lane.",
    "accent": "#c65f3d",
    "port": 7171,
    "readOnly": false,
    "contexts": [
      {
        "id": "main",
        "label": "Bakery tools",
        "home": "."
      }
    ]
  },
  "automation": {
    "ownerRole": "owner",
    "repositories": [],
    "sources": {
      "github": {
        "enabled": false,
        "prLimit": 20,
        "mergedLimit": 20,
        "runLimit": 10,
        "issueLimit": 20
      },
      "localFiles": {
        "enabled": false,
        "roots": []
      }
    },
    "workPolicy": {
      "readyStatus": "Ready for Build",
      "reviewStatus": "Needs Review",
      "allowStageMerge": false,
      "productionWrites": false
    },
    "packs": {
      "runtimes": [
        "generic"
      ]
    },
    "schedule": {
      "enabled": false,
      "hour": 7,
      "minute": 0
    }
  },
  "writerRegistry": {
    "agent": {
      "actions": {
        "built": "audit-only",
        "pr_opened": "reconcile",
        "merged": "reconcile",
        "skipped": "audit-only",
        "decision_added": "reconcile",
        "work_started": "audit-only",
        "work_checkpoint": "audit-only",
        "work_blocked": "audit-only",
        "work_verified": "audit-only",
        "work_shipped": "audit-only",
        "work_abandoned": "audit-only"
      }
    },
    "owner-ui": {
      "actions": {
        "decision_resolved": "reconcile",
        "decision_snoozed": "reconcile",
        "task_done": "audit-only",
        "board_reordered": "audit-only",
        "deck_answer": "audit-only",
        "deck_undo": "audit-only",
        "deck_need_info": "audit-only"
      }
    },
    "owner-capture": {
      "actions": {
        "owner_completed": "reconcile",
        "owner_skipped": "reconcile"
      }
    },
    "reconciler": {
      "actions": {
        "completion_propagated": "audit-only",
        "ticket_reconciled": "audit-only"
      }
    }
  },
  "commandGuide": [
    {
      "name": "/ledger-status",
      "description": "Print the current board summary and attention items without re-pulling sources."
    },
    {
      "name": "/ledger-sweep",
      "description": "Reconcile durable events, refresh observations, and rebuild the operating brief."
    },
    {
      "name": "/ledger-work",
      "description": "Pick and build the next safe ready-queue item, reporting bounded evidence."
    },
    {
      "name": "/ledger-attend",
      "description": "Present admitted owner decisions and exact manual actions for resolution."
    },
    {
      "name": "/ledger-sync",
      "description": "Push local ledger entries to the configured remote and pull any new ones."
    },
    {
      "name": "/ledger-view",
      "description": "Open the HFLedger engine UI in the default browser."
    }
  ],
  "schema": {
    "statuses": [
      "Needs Spec",
      "Ready for Build",
      "In Progress",
      "Needs Review",
      "Final Review",
      "Done",
      "Parked"
    ],
    "extraSections": {},
    "drawers": [],
    "protectedClasses": [
      "auth",
      "payments",
      "privacy",
      "legal",
      "financial",
      "data-migration",
      "brand"
    ],
    "gateClasses": {
      "decision": [
        "judgment",
        "protected-class",
        "production",
        "irreversible"
      ],
      "action": [
        "credential",
        "account-admin",
        "physical-device",
        "external-send",
        "production-manual",
        "protected-class"
      ]
    },
    "countedCollections": [
      "queue",
      "inbox",
      "ownerTasks",
      "decisions.total",
      "changelog.entries",
      "unmatchedCompletions",
      "retriage"
    ]
  }
}
