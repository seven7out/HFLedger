{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HFLedger",
  "version": "0.6.0-alpha.5",
  "identifier": "com.hfledger.desktop",
  "build": {
    "beforeBuildCommand": "npm run stage-runtime",
    "beforeDevCommand": "npm run stage-runtime",
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "HFLedger Settings",
        "visible": false,
        "width": 980,
        "height": 720,
        "minWidth": 760,
        "minHeight": 560,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "DeveloperTool",
    "shortDescription": "A local-first control room for human-agent handoffs",
    "resources": ["runtime/**/*"],
    "macOS": {
      "minimumSystemVersion": "14.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ]
  }
}
